# ============================================================
# Student Registration Management System Pro
# Apache / XAMPP Configuration
# ============================================================

# Disable directory listing globally
Options -Indexes

# ── Protect sensitive backend folders from direct HTTP access ─
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /STUDENT-MANAGEMENT-REGISTRATION-SYSTEM/

    # Block direct URL access to backend folders
    RewriteRule ^(config|classes|controllers|database)(/.*)?$ - [F,L]
</IfModule>

# ── Block PHP execution inside the uploads folder only ────────
<IfModule mod_rewrite.c>
    RewriteRule ^uploads/.*\.(php[0-9]?|phtml|phar)$ - [F,L]
</IfModule>

# ── HTTP Security Headers ─────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options  "nosniff"
    Header always set X-Frame-Options         "SAMEORIGIN"
    Header always set X-XSS-Protection        "1; mode=block"
    Header always set Referrer-Policy         "strict-origin-when-cross-origin"
    Header always set Permissions-Policy      "geolocation=(), microphone=(), camera=()"
</IfModule>

# ── Hide server signature ─────────────────────────────────────
ServerSignature Off

# ── PHP upload limits (XAMPP override) ───────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 3M
    php_value post_max_size       4M
</IfModule>
